// Mini ERP + CRM Operations Portal — database schema
//
// Design notes
// ------------
// * Money is stored as Decimal so totals never drift through float rounding.
// * Stock lives on `Product.currentStock` and every change is mirrored by a
//   `StockMovement` row, giving a complete, auditable inventory history.
// * `SalesChallanItem` keeps a full product snapshot (name/sku/category/price)
//   so a historical challan stays accurate even if the product changes later.
// * `NumberSequence` backs gap-free, race-safe challan number generation.

generator client {
  provider = "prisma-client-js"
  // `debian-openssl-3.0.x` matches the node:20-slim image used by the Docker
  // build, so the engines are present at build time rather than downloaded at
  // container start (where the unprivileged user cannot write to node_modules).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the running application.
  url      = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations. Neon routes DATABASE_URL
  // through PgBouncer, which cannot run the DDL a migration issues.
  // Prisma requires this variable to be present once declared — for a plain
  // PostgreSQL simply set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersCreated Customer[]         @relation("CustomerCreatedBy")
  followUps        CustomerFollowUp[] @relation("FollowUpCreatedBy")
  productsCreated  Product[]          @relation("ProductCreatedBy")
  stockMovements   StockMovement[]    @relation("StockMovementCreatedBy")
  challans         SalesChallan[]     @relation("ChallanCreatedBy")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @default(cuid())
  name         String
  mobile       String         @unique
  email        String
  businessName String
  gstNumber    String?
  type         CustomerType
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdById String
  createdBy   User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  followUps CustomerFollowUp[]
  challans  SalesChallan[]

  @@index([status])
  @@index([type])
  @@index([name])
  @@index([followUpDate])
  @@map("customers")
}

model CustomerFollowUp {
  id           String    @id @default(cuid())
  note         String
  followUpDate DateTime?
  createdAt    DateTime  @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_follow_ups")
}

// ---------------------------------------------------------------------------
// Products & inventory
// ---------------------------------------------------------------------------

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String
  unitPrice     Decimal  @db.Decimal(12, 2)
  currentStock  Int      @default(0)
  minStockAlert Int      @default(0)
  location      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdById String
  createdBy   User   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([category])
  @@index([name])
  @@index([location])
  @@map("products")
}

model StockMovement {
  id           String       @id @default(cuid())
  type         MovementType
  quantity     Int
  reason       String
  /// Stock level immediately after this movement — keeps the log self-auditing.
  balanceAfter Int
  createdAt    DateTime     @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Set when the movement was generated by confirming/cancelling a challan.
  challanId String?
  challan   SalesChallan? @relation(fields: [challanId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Sales challans
// ---------------------------------------------------------------------------

model SalesChallan {
  id            String        @id @default(cuid())
  challanNumber String        @unique
  status        ChallanStatus @default(DRAFT)
  totalQuantity Int           @default(0)
  totalAmount   Decimal       @default(0) @db.Decimal(14, 2)
  notes         String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("ChallanCreatedBy", fields: [createdById], references: [id])

  items          SalesChallanItem[]
  stockMovements StockMovement[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("sales_challans")
}

/// A line on a challan. Product details are snapshotted at creation time so the
/// document remains historically accurate regardless of later product edits.
model SalesChallanItem {
  id              String   @id @default(cuid())
  productName     String
  productSku      String
  productCategory String
  productLocation String
  unitPrice       Decimal  @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  challanId String
  challan   SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  /// Nullable on purpose: the snapshot above survives even if the product row goes away.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([challanId])
  @@map("sales_challan_items")
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// Atomic counters for human readable document numbers (e.g. CH-202608-0007).
model NumberSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}
